@using Microsoft.AspNetCore.Identity
@using AquariumForum.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var profileImage = !string.IsNullOrEmpty(user?.ImageFilename)
        ? $"/images/profiles/{user.ImageFilename}"
        : "/images/profiles/default.png"; // Default profile picture

        <li class="nav-item d-flex align-items-center">
            <img src="@profileImage" alt="Profile Picture" class="rounded-circle me-2" width="40" height="40" />
            <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                👋 Hello, @user.Name!
            </a>
        </li>

        <!-- REMOVED "My Photos" LINK -->

        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = ""})">
                <button id="logout" type="submit" class="nav-link btn btn-link text-danger border-0">
                    🚪 Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark fw-bold" id="register" asp-area="Identity" asp-page="/Account/Register">
                📝 Register
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark fw-bold" id="login" asp-area="Identity" asp-page="/Account/Login">
                🔑 Login
            </a>
        </li>
    }
</ul>
