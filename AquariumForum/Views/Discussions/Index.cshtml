@model IEnumerable<AquariumForum.Models.Discussion>

@{
    ViewData["Title"] = "Discussions";
}

<h1>Discussions</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">➕ New Discussion</a>
</p>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>Title</th>
            <th>Posted On</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.ActionLink(item.Title, "Details", new { id = item.DiscussionId })</td>
                <td>@item.CreateDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageFilename))
                    {
                        <img src="~/images/@item.ImageFilename" alt="Discussion Image" class="img-thumbnail" style="width: 80px; height: auto;" />
                    }
                    else
                    {
                        <span>No Image</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.DiscussionId" class="btn btn-link text-info" title="View">
                        <i class="fa-solid fa-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.DiscussionId" class="btn btn-link text-warning" title="Edit">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.DiscussionId" class="btn btn-link text-danger" title="Delete"
                       onclick="return confirm('Are you sure you want to delete this discussion?');">
                        <i class="fa-solid fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
