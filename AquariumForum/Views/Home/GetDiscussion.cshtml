@model AquariumForum.Models.Discussion

@{
    ViewData["Title"] = "Discussion - " + Model.Title;
}

<div class="container mt-4">
    <h2 class="text-center text-dark fw-bold">Discussion Details</h2>

    <div class="d-flex justify-content-center">
        <div class="card shadow-sm border-primary" style="width: 22rem;">
            @if (!string.IsNullOrEmpty(Model.ImageFilename))
            {
                <img src="~/images/@Model.ImageFilename" class="card-img-top rounded" alt="Discussion Image">
            }

            <div class="card-body">
                <h5 class="card-title text-primary">@Model.Title</h5>
                <p class="text-muted">
                    <i class="fa-solid fa-calendar"></i> @Model.CreateDate.ToString("yyyy-MM-dd HH:mm")
                </p>
                <p class="card-text">@Model.Content</p>
            </div>

            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <span>
                        <i class="fa-solid fa-comments"></i> @Model.Comments?.Count() Comments
                    </span>
                    <a class="btn btn-primary btn-sm" asp-controller="Comments" asp-action="Create" asp-route-discussionId="@Model.DiscussionId">
                        <i class="fa-solid fa-comment"></i> Add Comment
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h3 class="text-center">Comments</h3>
        <hr />

        @if (Model.Comments != null && Model.Comments.Any())
        {
            <div class="d-flex flex-column align-items-center">
                @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreateDate))
                {
                    <div class="card shadow-sm mb-2 border-light" style="width: 20rem;">
                        <div class="card-body">
                            <p class="card-text">@comment.Content</p>
                            <p class="text-muted small">
                                <i class="fa-solid fa-clock"></i> @comment.CreateDate.ToString("yyyy-MM-dd HH:mm")
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted text-center">No comments yet. Be the first to comment!</p>
        }
    </div>

    <div class="text-center mt-4">
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i> Back to Discussions
        </a>
    </div>
</div>
